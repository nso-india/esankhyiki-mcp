# Feedback storage (optional)
# Google Sheet ID from https://docs.google.com/spreadsheets/d/<ID>/edit
# Create a Feedback tab and share the sheet with the service account as Editor.
# Export these variables in the server environment; .env is not loaded automatically.
FEEDBACK_SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json

# OpenTelemetry Configuration
# Copy this file to .env and adjust values as needed

# Service name shown in traces
OTEL_SERVICE_NAME=mospi-mcp-server

# OTLP collector endpoint (Jaeger, Grafana Tempo, etc.)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Protocol: grpc (default) or http/protobuf
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Exporter type: otlp, console, or none
OTEL_TRACES_EXPORTER=otlp

# Disable metrics and logs export (not needed for this server)
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# Optional: Sampling rate (1.0 = 100%, 0.1 = 10%)
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0

# Optional: Resource attributes for additional metadata
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development,service.version=1.0.0
